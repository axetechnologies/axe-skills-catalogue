    "/v1/skills/{name}": {
      "get": {
        "summary": "Fetch one skill by its fully qualified name.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name is both the primary key and the address; it is not URL-shortened."
          },
          {
            "name": "X-AXE-Tenant",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Tenant to read. Optional where the origin sets a default tenant; otherwise a missing tenant is a 403."
          },
          {
            "name": "version",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Exact version. Only the current version of a skill has a stored body."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "No tenant could be resolved for this request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No such route or skill.",
